# Sin esto, `engines` es una NOTA y no una guarda: npm avisa y sigue.
# Con `engine-strict`, una version fuera del rango falla AL INSTALAR, y el mensaje
# nombra la version que hay y la que se pide.
#
# `.nvmrc` dice CUAL usar y de el sale la version de la CI (`node-version-file`);
# esto impide que alguien instale con otra sin enterarse. Son las dos mitades de la
# misma afirmacion, y por separado ninguna la sostiene.
engine-strict=true
